import requests
import time
import json
import statistics
import sys

VLSELECT_URL = "http://localhost:8004"

QUERIES = [
    ("Simple count", "* | count()"),
    ("Error count", "level:ERROR | count()"),
    ("Critical count", "level:CRITICAL | count()"),
    ("Count by service", "* | stats by (service_name) count()"),
    ("Count by host", "* | stats by (host_name) count()"),
    ("Count by level", "* | stats by (level) count()"),
    ("Last 1 hour errors", "_time:1h AND level:ERROR | count()"),
    ("Last 6 hours errors", "_time:6h AND level:ERROR | count()"),
    ("Last 24 hours errors", "_time:24h AND level:ERROR | count()"),
    ("High memory usage", "memory_mb:>15000 | count()"),
    ("High CPU usage", "cpu_percent:>80 | count()"),
    ("Multiple retries", "retry_count:>2 | count()"),
    ("Errors on kafka", "level:ERROR AND service_name:kafka | count()"),
    ("High memory errors", "level:ERROR AND memory_mb:>20000 | count()"),
    ("Extract trace IDs", "* | extract trace_id | count()"),
    ("Average duration", "* | stats avg(duration_ms)"),
    ("P95 duration", "* | stats p95(duration_ms)"),
    ("Top 5 services by errors", "level:ERROR | top 5 service_name"),
    ("Top 10 hosts by logs", "* | top 10 host_name"),
    ("Contains 'timeout'", "message:timeout | count()"),
]

results = []
print("\n  Running 20 query patterns...\n")

for name, query in QUERIES:
    print(f"    {name:30}...", end=" ", flush=True)
    times = []
    for i in range(5):
        start = time.time()
        try:
            resp = requests.get(f"{VLSELECT_URL}/select/logsql/query", params={"query": query}, timeout=30)
            elapsed = (time.time() - start) * 1000
            times.append(elapsed)
        except:
            times.append(0)
        time.sleep(0.1)
    avg_time = statistics.mean([t for t in times if t > 0]) if times else 0
    results.append({"query": name, "time_ms": round(avg_time, 2)})
    print(f"✅ {avg_time:.2f}ms")

all_times = [r["time_ms"] for r in results]
print("\n" + "="*60)
print("  QUERY PERFORMANCE STATISTICS")
print("="*60)
print(f"\n  Average: {statistics.mean(all_times):.2f} ms")
print(f"  Median:  {statistics.median(all_times):.2f} ms")
print(f"  Minimum: {min(all_times):.2f} ms")
print(f"  Maximum: {max(all_times):.2f} ms")

fastest = sorted(results, key=lambda x: x["time_ms"])[:5]
print("\n  Fastest Queries (<15ms):")
for q in fastest:
    if q["time_ms"] < 15:
        print(f"    {q['query']:30} - {q['time_ms']:.2f} ms")

slowest = sorted(results, key=lambda x: x["time_ms"], reverse=True)[:5]
print("\n  Slowest Queries (>40ms):")
for q in slowest:
    if q["time_ms"] > 40:
        print(f"    {q['query']:30} - {q['time_ms']:.2f} ms")

with open(sys.argv[1], 'w') as f:
    json.dump(results, f, indent=2)
